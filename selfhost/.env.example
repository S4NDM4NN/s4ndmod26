# Copy to .env and edit.

# The server image.  Pin a version (a tag like v26.11.12-18072ca3) to choose when you update.
#S4ND_SERVER_IMAGE=repo.s4ndmod.com/s4ndmod/s4ndmod26:latest

# Game port (UDP).  Forward it on your router.
GAME_PORT=27960
# The agent's port (TCP).  Forward it too if you are not using the https profile.
AGENT_PORT=27970

# For browser players (the https profile): a DNS name pointing at this machine, and the matching public URL.
#DOMAIN=game.example.com
#PUBLIC_URL=https://game.example.com

# Only used the first time, when the server folder has no server.cfg yet.  Empty: a random password is written
# into server/server.cfg.
#RCON_PASSWORD=
